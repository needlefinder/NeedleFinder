font.family: sans-serif
font.sans-serif: IBM Plex Sans, Fira Sans, Source Sans Pro, Inter, DejaVu Sans
mathtext.fontset: stixsans
font.size: 8.5
axes.labelsize: 9.0
axes.titlesize: 9.5
axes.titleweight: bold
xtick.labelsize: 8.0
ytick.labelsize: 8.0
legend.fontsize: 8.0
legend.frameon: False
axes.linewidth: 0.75
axes.edgecolor: 2B2B2B
axes.labelcolor: 1A1A1A
text.color: 1A1A1A
xtick.color: 2B2B2B
ytick.color: 2B2B2B
axes.spines.top: False
axes.spines.right: False
xtick.direction: out
ytick.direction: out
xtick.major.size: 3.0
ytick.major.size: 3.0
xtick.major.width: 0.7
ytick.major.width: 0.7
lines.linewidth: 1.5
lines.markersize: 5.0
axes.grid: False
grid.color: E2E5E9
grid.linewidth: 0.5
savefig.dpi: 600
savefig.bbox: tight
savefig.pad_inches: 0.04
pdf.fonttype: 42
ps.fonttype: 42
