font.family: sans-serif
font.sans-serif: DejaVu Sans, TeX Gyre Heros, Helvetica, Arial
mathtext.fontset: dejavusans
font.size: 7
axes.labelsize: 8
axes.titlesize: 8
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7
legend.frameon: False
axes.linewidth: 0.6
axes.edgecolor: 333333
axes.spines.top: False
axes.spines.right: False
xtick.direction: out
ytick.direction: out
xtick.major.size: 2.5
ytick.major.size: 2.5
xtick.major.width: 0.6
ytick.major.width: 0.6
lines.linewidth: 1.2
lines.markersize: 4
axes.grid: False
grid.color: E6E6E6
grid.linewidth: 0.4
savefig.dpi: 600
savefig.bbox: tight
savefig.pad_inches: 0.03
pdf.fonttype: 42
ps.fonttype: 42
